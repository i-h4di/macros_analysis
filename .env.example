# ─────────────────────────────────────────────────────────────
# Sa'arati environment configuration
# Copy this file to `.env` and fill in a key for ONE provider.
# ─────────────────────────────────────────────────────────────

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# ── AI provider (choose one; all use an OpenAI-compatible /chat/completions API) ──
# Supported values for LLM_PROVIDER: gemini | deepseek | openai
LLM_PROVIDER="gemini"
LLM_API_KEY="your-api-key-here"

# LLM_BASE_URL and LLM_MODEL are optional — sensible defaults are picked from
# LLM_PROVIDER. Override them only if you need a different endpoint/model.
# LLM_BASE_URL=""
# LLM_MODEL=""

# ── Option A: Google Gemini (recommended — has a genuinely FREE tier) ──
# Get a key at https://aistudio.google.com/apikey
#   LLM_PROVIDER="gemini"
#   LLM_API_KEY="AIza..."
#   (defaults: base https://generativelanguage.googleapis.com/v1beta/openai
#              model gemini-1.5-flash)

# ── Option B: DeepSeek (very cheap, text-only API) ──
# Get a key at https://platform.deepseek.com
#   LLM_PROVIDER="deepseek"
#   LLM_API_KEY="sk-..."
#   (defaults: base https://api.deepseek.com  model deepseek-chat)

# ── Option C: OpenAI ──
#   LLM_PROVIDER="openai"
#   LLM_API_KEY="sk-..."
#   (defaults: base https://api.openai.com/v1  model gpt-4o-mini)
